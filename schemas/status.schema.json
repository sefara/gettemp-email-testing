{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gettemp.email/contracts/testing/status.v1.schema.json",
  "title": "Developer API status",
  "type": "object",
  "required": ["plan", "quota"],
  "properties": {
    "plan": { "type": "string", "enum": ["developer"] },
    "quota": {
      "type": "object",
      "required": [
        "remainingMinute",
        "remainingDay",
        "remainingWeek",
        "remainingMonth",
        "resetDayAt",
        "resetWeekAt",
        "resetMonthAt"
      ],
      "properties": {
        "remainingMinute": { "type": "integer", "minimum": 0 },
        "remainingDay": { "type": "integer", "minimum": 0 },
        "remainingWeek": { "type": "integer", "minimum": 0 },
        "remainingMonth": { "type": "integer", "minimum": 0 },
        "resetDayAt": { "type": "string", "format": "date-time" },
        "resetWeekAt": { "type": "string", "format": "date-time" },
        "resetMonthAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
