{
  "name": "@gettemp-email/testing",
  "version": "0.2.1",
  "description": "Disposable inbox helpers for automated email verification tests.",
  "type": "module",
  "license": "MIT",
  "author": "KOOL4 Solutions s. r. o.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefara/gettemp-email-testing.git"
  },
  "homepage": "https://gettemp.email/guides/test-email-verification-playwright/",
  "bugs": {
    "url": "https://github.com/sefara/gettemp-email-testing/issues"
  },
  "keywords": [
    "email-testing",
    "playwright",
    "temporary-email",
    "mcp",
    "verification"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gettemp-email-testing": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./playwright": "./src/playwright.js"
  },
  "files": [
    "src/",
    "examples/",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "schemas/",
    "docs/ROADMAP.md",
    "integration-manifest.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:browser": "node scripts/browser-example-regression.mjs",
    "test:live": "node scripts/live-playwright-controlled-flow.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check src/cli.js && node --check src/client.js && node --check src/helpers.js && node --check src/init.js && node --check scripts/live-playwright-controlled-flow.mjs && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "playwright-core": "1.55.1"
  }
}
